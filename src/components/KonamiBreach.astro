---
---
<div id="breach-modal" class="fixed inset-0 z-50 pointer-events-none hidden items-center justify-center p-4">
  <div class="bg-red-950/90 border-2 border-red-500 rounded-xl p-6 font-mono text-center shadow-[0_0_50px_rgba(239,68,68,0.5)] pointer-events-auto max-w-lg w-full animate-bounce">
    <div class="text-red-400 font-bold text-lg mb-2">
      ⚠ ROOT OVERRIDE GRANTED ⚠
    </div>
    <p class="text-xs text-red-200 mb-4 leading-relaxed">
      SECURITY BREACH SIMULATED // KERNEL RUNLEVEL 0<br/>
      ALL ACCESS CONTROL POLICIES TEMPORARILY SUSPENDED.
    </p>
    <div class="flex justify-center gap-3">
      <button id="dismiss-breach" class="px-4 py-1.5 bg-red-600 hover:bg-red-500 text-white text-xs font-bold rounded transition cursor-pointer">
        [DISMISS ALARM]
      </button>
    </div>
  </div>
</div>

<script>
  const sequence = [
    'ArrowUp', 'ArrowUp',
    'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight',
    'ArrowLeft', 'ArrowRight',
    'b', 'a'
  ];
  let position = 0;

  window.addEventListener('keydown', (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    const required = sequence[position].length === 1 ? sequence[position].toLowerCase() : sequence[position];

    if (key === required) {
      position++;
      if (position === sequence.length) {
        triggerBreach();
        position = 0;
      }
    } else {
      position = 0;
    }
  });

  function triggerBreach() {
    const modal = document.getElementById('breach-modal');
    if (!modal) return;

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    // Trigger Matrix Rain red color shift if active
    if ((window as any).__setMatrixColor) {
      (window as any).__setMatrixColor('#ef4444', 18);
    }

    document.getElementById('dismiss-breach')?.addEventListener('click', closeBreach);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBreach();
    }, { once: true });
  }

  function closeBreach() {
    const modal = document.getElementById('breach-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');

    if ((window as any).__setMatrixColor) {
      (window as any).__setMatrixColor('#34d399', 35);
    }
  }
</script>
