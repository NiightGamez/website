<!-- Minimal background-integrated top scroll indicator -->
<div id="ambient-scroll-line" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-emerald-500/20 via-emerald-400/60 to-emerald-300 z-50 transition-all duration-75 pointer-events-none" style="width: 0%;"></div>

<script>
  function setupScrollProgress() {
    const line = document.getElementById('ambient-scroll-line');
    if (!line) return;

    function onScroll() {
      const scrollH = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollH <= 20) {
        line.style.width = '0%';
        return;
      }
      const progress = Math.min(Math.max(window.scrollY / scrollH, 0), 1);
      line.style.width = `${progress * 100}%`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  setupScrollProgress();
  document.addEventListener('astro:after-swap', setupScrollProgress);
</script>
