<script>
  function updateUptime() {
    const epochOrigin = new Date('2026-01-01T00:00:00Z').getTime();
    const diff = Date.now() - epochOrigin;
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const target = document.getElementById('nf-uptime');
    if (target) target.textContent = `${days} days, ${hours} hours, live`;
  }
  updateUptime();
  document.addEventListener('astro:after-swap', updateUptime);
</script>
