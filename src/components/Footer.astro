---
const currentYear = new Date().getFullYear();
---
<footer class="w-full border-t border-slate-800/80 py-6 text-xs text-slate-500 font-mono mt-12 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
    <div class="text-[11px] sm:text-xs md:whitespace-nowrap">
      &copy; {currentYear} Michael Voorhies &bull; All Rights Reserved &bull; Self-hosted on Proxmox VE &bull; Built with Astro
    </div>
    <div class="text-slate-600 flex items-center justify-center gap-2 whitespace-nowrap shrink-0 text-[11px] sm:text-xs">
      <span>PWR: AC [NOMINAL]</span>
      <span>&bull;</span>
      <span>press <kbd class="px-1.5 py-0.5 bg-slate-900 border border-slate-800 rounded text-slate-400 text-[10px]">?</kbd> for keys</span>
    </div>
  </div>
</footer>
