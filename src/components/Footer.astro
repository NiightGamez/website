---
import BatteryStatus from './BatteryStatus.astro';
---
<footer class="w-full border-t border-slate-800/80 py-6 text-xs text-slate-500 font-mono mt-12 select-none">
  <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div>
      &copy; 2026 Michael Voorhies &bull; Self-hosted on Proxmox VE &bull; Built with Astro
    </div>
    <div class="flex items-center gap-3">
      <BatteryStatus />
      <span class="text-slate-600 hidden sm:inline">&bull;</span>
      <span class="text-slate-500 text-[11px]">press <kbd class="px-1 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">?</kbd> for keys</span>
    </div>
  </div>
</footer>
