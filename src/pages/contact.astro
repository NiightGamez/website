---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<BaseLayout title="Contact & Inquiries" currentPage="contact">
  <header class="mb-8 sm:mb-10 animate-fade-in">
    <div class="inline-block px-2.5 py-0.5 mb-3 bg-emerald-950/60 border border-emerald-800/60 font-mono text-xs text-emerald-400 rounded">
      ❯ COMMS_DISPATCH // SMTP_REDIRECT
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3 text-white leading-tight font-mono">
      Direct Channels &amp; Dispatch
    </h1>
    <p class="text-sm sm:text-base text-slate-400 leading-relaxed font-sans">
      Complete the verification check below to unlock direct communication channels and transmit inquiries.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 animate-fade-in delay-100">
    
    <!-- Dispatcher Terminal Container -->
    <section class="md:col-span-2 bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden font-mono text-xs shadow-xl">
      <div class="bg-slate-950 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-slate-400">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 text-slate-300">comms_dispatcher.sh</span>
        </div>
        <span class="text-slate-600 text-[11px]">PORT: 587 // TLS</span>
      </div>

      <form id="contact-composer" class="p-5 space-y-4">
        <div>
          <label for="dispatch-type" class="block text-slate-400 mb-1 text-[11px]">
            <span class="text-emerald-400">01.</span> INQUIRY_ROUTING:
          </label>
          <select 
            id="dispatch-type"
            class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 focus:outline-none focus:border-emerald-500/80 transition cursor-pointer"
          >
            <option value="[General Inquiry]">01 // General Inquiry &amp; Networking</option>
            <option value="[Photography / Portrait]">02 // Photography / Portrait &amp; Print Booking</option>
            <option value="[Systems / Cyber Consulting]">03 // Systems &amp; Defensive Security Consulting</option>
          </select>
        </div>

        <div>
          <label for="sender-name" class="block text-slate-400 mb-1 text-[11px]">
            <span class="text-emerald-400">02.</span> SENDER_IDENTITY:
          </label>
          <input 
            type="text" 
            id="sender-name" 
            required 
            placeholder="Name or Organization"
            class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition"
          />
        </div>

        <div>
          <label for="msg-subject" class="block text-slate-400 mb-1 text-[11px]">
            <span class="text-emerald-400">03.</span> DISPATCH_SUBJECT:
          </label>
          <input 
            type="text" 
            id="msg-subject" 
            required 
            placeholder="Project scope, date, or opportunity..."
            class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition"
          />
        </div>

        <div>
          <label for="msg-body" class="block text-slate-400 mb-1 text-[11px]">
            <span class="text-emerald-400">04.</span> MESSAGE_PAYLOAD:
          </label>
          <textarea 
            id="msg-body" 
            rows="5" 
            required 
            placeholder="Provide engagement details or questions here..."
            class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition resize-none"
          ></textarea>
        </div>

        <!-- Inline Turnstile Challenge -->
        <div class="py-1">
          <div id="contact-turnstile-container" class="min-h-[65px] flex items-center justify-start"></div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-t border-slate-800/60">
          <span id="dispatch-status" class="text-slate-500 text-[11px]">
            Awaiting verification to unlock...
          </span>
          <button 
            id="contact-submit-btn"
            type="submit" 
            disabled
            class="px-4 py-2 bg-emerald-950/40 border border-emerald-900/60 text-emerald-600 rounded transition duration-150 flex items-center gap-2 font-bold cursor-not-allowed opacity-60"
          >
            <span>TRANSMIT DISPATCH</span>
            <span>❯</span>
          </button>
        </div>
      </form>
    </section>

    <!-- Sidebar Direct Channels -->
    <div class="flex flex-col gap-4">
      <div class="p-5 bg-slate-900/60 border border-slate-800 rounded-xl card-hover flex flex-col justify-between">
        <div>
          <div class="text-[11px] font-mono text-emerald-400 uppercase tracking-wider mb-1">[DIRECT] Primary Inbox</div>
          <h2 class="text-lg font-bold text-white mb-2 font-mono">Encrypted Mail</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-3">
            Direct communication channel hosted via ProtonMail:
          </p>
        </div>
        <div id="email-lock-wrapper">
          <span id="email-locked-state" class="text-xs font-mono text-slate-500 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500/80"></span>
            [LOCKED // SOLVE CAPTCHA]
          </span>
          <a id="email-unlocked-link" href="#" class="hidden text-xs font-mono text-emerald-400 hover:underline break-all"></a>
        </div>
      </div>

      <a href="https://github.com/NiightGamez" target="_blank" rel="noopener noreferrer" class="p-5 bg-slate-900/60 border border-slate-800 rounded-xl card-hover flex flex-col justify-between group">
        <div>
          <div class="text-[11px] font-mono text-emerald-400 uppercase tracking-wider mb-1">[GIT] Version Control</div>
          <h2 class="text-lg font-bold text-white mb-2 font-mono flex items-center justify-between">
            <span>GitHub</span>
            <span class="text-emerald-400 group-hover:translate-x-1 transition-transform duration-200 text-xs">&nearr;</span>
          </h2>
          <p class="text-xs text-slate-400 leading-relaxed">
            Review open source repositories, lab implementations, and configs[cite: 9].
          </p>
        </div>
        <div class="text-xs font-mono text-slate-500 mt-3">@NiightGamez</div>
      </a>
    </div>

  </div>
</BaseLayout>

<script define:vars={{ siteKey }}>
  let contactTurnstileToken = null;
  let resolvedAddress = null;
  const encodedInbox = "Y29udGFjdEBtdm9vcmhpZXMuY29t";

  function initContactTurnstile() {
    const container = document.getElementById('contact-turnstile-container');
    const submitBtn = document.getElementById('contact-submit-btn');
    const status = document.getElementById('dispatch-status');
    const lockedState = document.getElementById('email-locked-state');
    const unlockedLink = document.getElementById('email-unlocked-link');

    if (!container || !window.turnstile) return;

    window.turnstile.render('#contact-turnstile-container', {
      sitekey: siteKey,
      theme: 'dark',
      callback: function(token) {
        contactTurnstileToken = token;
        resolvedAddress = atob(encodedInbox);

        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.className = "px-4 py-2 bg-emerald-950/90 hover:bg-emerald-900 border border-emerald-700 text-emerald-400 rounded transition duration-150 flex items-center gap-2 font-bold cursor-pointer opacity-100";
        }
        if (status) {
          status.textContent = "Identity verified. Transmission unlocked.";
          status.className = "text-emerald-400 text-[11px]";
        }

        if (lockedState && unlockedLink) {
          lockedState.classList.add('hidden');
          unlockedLink.textContent = `${resolvedAddress} →`;
          unlockedLink.href = `mailto:${resolvedAddress}`;
          unlockedLink.classList.remove('hidden');
        }
      },
      'expired-callback': function() {
        contactTurnstileToken = null;
        resolvedAddress = null;
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.className = "px-4 py-2 bg-emerald-950/40 border border-emerald-900/60 text-emerald-600 rounded transition duration-150 flex items-center gap-2 font-bold cursor-not-allowed opacity-60";
        }
        if (status) {
          status.textContent = "Token expired. Please reverify.";
          status.className = "text-amber-400 text-[11px]";
        }
        if (lockedState && unlockedLink) {
          lockedState.classList.remove('hidden');
          unlockedLink.classList.add('hidden');
        }
      }
    });
  }

  function setupDispatcher() {
    const form = document.getElementById('contact-composer');
    const status = document.getElementById('dispatch-status');

    if (!form) return;

    if (window.turnstile) {
      initContactTurnstile();
    } else {
      const timer = setInterval(() => {
        if (window.turnstile) {
          clearInterval(timer);
          initContactTurnstile();
        }
      }, 150);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!contactTurnstileToken || !resolvedAddress) {
        if (status) {
          status.textContent = 'Please complete human verification first.';
          status.className = 'text-rose-400 text-[11px]';
        }
        return;
      }

      const typeSelect = document.getElementById('dispatch-type');
      const nameInput = document.getElementById('sender-name');
      const subjectInput = document.getElementById('msg-subject');
      const bodyInput = document.getElementById('msg-body');

      const category = typeSelect?.value || '[General Inquiry]';
      const sender = nameInput?.value.trim() || 'Anonymous';
      const userSubject = subjectInput?.value.trim() || 'Inquiry';
      const body = bodyInput?.value.trim() || '';

      const fullSubject = `${category} ${userSubject}`;
      const formattedBody = `${body}\n\n---\nCategory: ${category}\nSender: ${sender}\nTransmitted from: ${window.location.origin}/contact\nCF-Turnstile: [Verified: ${contactTurnstileToken.slice(0, 16)}...]`;
      const mailtoUri = `mailto:${resolvedAddress}?subject=${encodeURIComponent(fullSubject)}&body=${encodeURIComponent(formattedBody)}`;

      if (status) {
        status.textContent = 'Launching email client...';
        status.className = 'text-emerald-400 text-[11px]';
      }

      window.location.href = mailtoUri;

      setTimeout(() => {
        if (status) {
          status.textContent = 'Dispatched to client buffer. Transmit when ready.';
          status.className = 'text-slate-400 text-[11px]';
        }
      }, 1500);
    });
  }

  document.addEventListener('DOMContentLoaded', setupDispatcher);
</script>
