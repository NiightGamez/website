---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Photography & Visual Work" currentPage="photos">
  <header class="mb-8 animate-fade-in">
    <div class="inline-block px-2.5 py-0.5 mb-3 bg-emerald-950/60 border border-emerald-800/60 font-mono text-xs text-emerald-400 rounded">
      PORTFOLIO // UPDATED CONTINUOUSLY
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3 text-white leading-tight font-mono">
      Photography & Visual Studies
    </h1>
    <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans max-w-2xl">
      A collection of landscape, environmental, and observational photography captured primarily with Canon glass. Focused on natural textures, low light, and quiet framing.
    </p>
  </header>

  <!-- Live Filter & Sort Toolbar -->
  <section class="mb-8 p-3 bg-slate-900/60 border border-slate-800 rounded-xl flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
    <div class="flex flex-wrap items-center gap-1.5" id="filter-controls">
      <span class="text-slate-500 mr-1 text-[11px]">FILTER:</span>
      <button data-filter="all" class="filter-btn px-2.5 py-1 rounded bg-emerald-950 border border-emerald-700 text-emerald-400 transition cursor-pointer">ALL</button>
      <button data-filter="lowlight" class="filter-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition cursor-pointer">LOW LIGHT (ISO 800+)</button>
      <button data-filter="canon" class="filter-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition cursor-pointer">CANON OPTICS</button>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-slate-500 text-[11px]">SORT:</span>
      <button id="sort-toggle-btn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition cursor-pointer flex items-center gap-1">
        <span id="sort-label">NEWEST</span>
        <span id="sort-icon">↓</span>
      </button>
    </div>
  </section>

  <!-- Photo Grid -->
  <section id="gallery-container" class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-16">
    <div id="gallery-loader" class="col-span-full py-16 flex flex-col items-center justify-center gap-3 text-slate-400 font-mono text-xs">
      <div class="w-6 h-6 border-2 border-emerald-500/30 border-t-emerald-400 rounded-full animate-spin"></div>
      <span>CONNECTING_TO_IMMICH_ARCHIVE...</span>
    </div>
  </section>

  <!-- Prints & Contact Banner -->
  <section class="p-6 sm:p-8 bg-slate-900/50 border border-slate-800 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 animate-fade-in delay-200">
    <div>
      <h3 class="text-base font-semibold text-white mb-1 font-mono">Prints and Inquiries</h3>
      <p class="text-sm text-slate-400 font-sans max-w-xl leading-relaxed">
        Interested in a print or want to say hi? Transmit a dispatch or reach out directly.
      </p>
    </div>
    <button id="open-dispatch-btn" type="button" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-slate-600 text-white text-xs font-mono rounded-lg transition whitespace-nowrap cursor-pointer flex items-center gap-2">
      <span>Get in Touch</span>
      <span>→</span>
    </button>
  </section>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden opacity-0 transition-opacity duration-200 flex flex-col items-center justify-center p-4 sm:p-8">
    <button id="lightbox-close" class="absolute top-4 right-4 sm:top-6 sm:right-6 text-slate-400 hover:text-white bg-slate-900/80 border border-slate-700 p-2 rounded-full font-mono text-xs transition cursor-pointer" aria-label="Close photo">
      ✕ ESC
    </button>
    <div class="max-w-5xl max-h-[85vh] flex flex-col items-center justify-center relative select-none">
      <img id="lightbox-img" src="" alt="" draggable="false" oncontextmenu="return false;" class="max-h-[75vh] max-w-[92vw] w-auto h-auto object-contain rounded-lg shadow-2xl pointer-events-none select-none" />
      <div class="mt-4 flex flex-col sm:flex-row items-center gap-2 text-center text-xs font-mono text-slate-300">
        <span id="lightbox-title" class="font-sans font-medium text-white"></span>
        <span class="hidden sm:inline text-slate-600">•</span>
        <span id="lightbox-settings" class="text-emerald-400"></span>
      </div>
    </div>
  </div>

  <!-- Terminal Dispatcher Modal -->
  <div id="dispatch-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-xl rounded-xl shadow-2xl overflow-hidden font-mono text-xs flex flex-col animate-fade-in">
      <div class="bg-slate-950 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-slate-400">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 text-slate-300">comms_dispatcher.sh</span>
        </div>
        <button id="close-dispatch-btn" type="button" class="text-slate-500 hover:text-white transition cursor-pointer">ESC</button>
      </div>

      <div class="px-5 py-3 bg-slate-950/60 border-b border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400">[DIRECT]</span>
          <span class="text-slate-400 text-[11px]">Primary Inbox:</span>
          <a href="mailto:contact@mvoorhies.com" class="text-emerald-400 hover:underline text-xs">contact@mvoorhies.com</a>
        </div>
        <button id="copy-email-btn" type="button" class="self-start sm:self-auto text-[10px] px-2 py-0.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 rounded transition cursor-pointer">
          COPY
        </button>
      </div>

      <form id="contact-composer" class="p-5 space-y-4">
        <div>
          <label for="sender-name" class="block text-slate-400 mb-1 text-[11px]"><span class="text-emerald-400">01.</span> SENDER_IDENTITY:</label>
          <input type="text" id="sender-name" required placeholder="Name or Handle" class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition" />
        </div>
        <div>
          <label for="msg-subject" class="block text-slate-400 mb-1 text-[11px]"><span class="text-emerald-400">02.</span> DISPATCH_SUBJECT:</label>
          <input type="text" id="msg-subject" required value="Photography / Print Inquiry" class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition" />
        </div>
        <div>
          <label for="msg-body" class="block text-slate-400 mb-1 text-[11px]"><span class="text-emerald-400">03.</span> MESSAGE_PAYLOAD:</label>
          <textarea id="msg-body" rows="4" required placeholder="Inquiry or message details..." class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition resize-none"></textarea>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <span id="dispatch-status" class="text-slate-500 text-[11px]">Ready to transmit.</span>
          <button type="submit" class="px-4 py-2 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800 text-emerald-400 rounded transition duration-150 flex items-center gap-2 cursor-pointer font-bold">
            <span>TRANSMIT DISPATCH</span><span>❯</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  interface PhotoAsset {
    id: string;
    date: string;
    exif: {
      lensModel?: string;
      model?: string;
      fNumber?: number | string;
      exposureTime?: string;
      iso?: number | string;
    };
  }

  const SHARE_KEY = import.meta.env.PUBLIC_IMMICH_SHARE_KEY || '';
  const ALBUM_ID = import.meta.env.PUBLIC_IMMICH_ALBUM_ID || '';
  const CACHE_KEY = 'immich-v3-' + SHARE_KEY.slice(0, 12);
  const TTL = 10 * 60 * 1000;

  let globalAssets: PhotoAsset[] = [];
  let currentFilter = 'all';
  let sortDescending = true;

  function esc(s: unknown) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function readCache() {
    try { return JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); } catch { return null; }
  }

  async function getAssets(): Promise<PhotoAsset[]> {
    const cached = readCache();
    if (cached && Date.now() - cached.at < TTL) return cached.assets;

    try {
      const res = await fetch('/immich-api/search/metadata?key=' + encodeURIComponent(SHARE_KEY), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ albumIds: [ALBUM_ID], size: 250, withExif: true })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const raw = data.assets?.items || [];

      const assets: PhotoAsset[] = raw
        .filter((a: { type?: string }) => !a.type || a.type === 'IMAGE')
        .map((a: { id: string; fileCreatedAt?: string; localDateTime?: string; exifInfo?: PhotoAsset['exif'] }) => ({
          id: a.id,
          date: a.fileCreatedAt || a.localDateTime || '',
          exif: {
            lensModel: a.exifInfo?.lensModel,
            model: a.exifInfo?.model,
            fNumber: a.exifInfo?.fNumber,
            exposureTime: a.exifInfo?.exposureTime,
            iso: a.exifInfo?.iso
          }
        }));

      if (assets.length) { try { localStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), assets })); } catch {} }
      return assets;
    } catch (err) {
      if (cached) return cached.assets;
      throw err;
    }
  }

  function renderGallery() {
    const container = document.getElementById('gallery-container');
    if (!container) return;

    // Filter logic
    let filtered = [...globalAssets];
    if (currentFilter === 'lowlight') {
      filtered = filtered.filter(a => Number(a.exif?.iso || 0) >= 800);
    } else if (currentFilter === 'canon') {
      filtered = filtered.filter(a => /canon/i.test(a.exif?.model || '') || /canon/i.test(a.exif?.lensModel || ''));
    }

    // Sort logic
    filtered.sort((a, b) => {
      const cmp = (b.date || '').localeCompare(a.date || '');
      return sortDescending ? cmp : -cmp;
    });

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="col-span-full p-8 text-center bg-slate-900/50 border border-slate-800 rounded-xl text-slate-400 text-sm font-mono">
          [!] No photos match the active filter criteria.
        </div>`;
      return;
    }

    container.innerHTML = filtered.map((asset) => {
      const thumbUrl = `/immich-api/assets/${asset.id}/thumbnail?size=preview&key=${encodeURIComponent(SHARE_KEY)}`;
      const exif = asset.exif || {};
      const lens = exif.lensModel || '';
      const camera = exif.model ? (/^canon/i.test(exif.model) ? exif.model : `Canon ${exif.model}`) : 'Canon Optics';
      const fStop = exif.fNumber ? `f/${exif.fNumber}` : '';
      const shutter = exif.exposureTime ? `${exif.exposureTime}s` : '';
      const iso = exif.iso ? `ISO ${exif.iso}` : '';
      const settings = [fStop, shutter, iso].filter(Boolean).join('  ·  ');
      const title = lens || camera;

      return `
        <article class="p-4 sm:p-5 bg-slate-900/60 border border-slate-800/90 rounded-2xl card-hover animate-fade-in flex flex-col justify-between group">
          <button type="button"
            class="photo-trigger aspect-[4/3] overflow-hidden bg-slate-950 block rounded-xl mb-4 relative cursor-zoom-in text-left w-full focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            data-img="${esc(thumbUrl)}" data-title="${esc(title)}" data-settings="${esc(settings)}" title="Click to view photograph">
            <img src="${esc(thumbUrl)}" alt="${esc(title)}" loading="lazy" draggable="false" oncontextmenu="return false;"
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 pointer-events-none select-none" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <span class="text-xs text-white bg-slate-900/80 backdrop-blur px-2.5 py-1 rounded-md border border-slate-700 font-mono">View Photo ↗</span>
            </div>
          </button>
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <span class="text-xs font-medium text-slate-200">${esc(title)}</span>
              ${settings ? `<span class="text-[11px] font-mono text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-900/50">${esc(settings)}</span>` : ''}
            </div>
            <div class="flex justify-between items-center text-[11px] text-slate-500 pt-2 border-t border-slate-800/60 mt-2">
              <span>${esc(exif.model ? camera : 'Digital Capture')}</span>
              <span class="text-slate-600 font-mono text-[10px]">LIVE SYNC</span>
            </div>
          </div>
        </article>`;
    }).join('');

    bindLightboxEvents();
  }

  function setupFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const sortBtn = document.getElementById('sort-toggle-btn');
    const sortLabel = document.getElementById('sort-label');
    const sortIcon = document.getElementById('sort-icon');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.className = 'filter-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition cursor-pointer';
        });
        btn.className = 'filter-btn px-2.5 py-1 rounded bg-emerald-950 border border-emerald-700 text-emerald-400 transition cursor-pointer';
        currentFilter = btn.getAttribute('data-filter') || 'all';
        renderGallery();
      });
    });

    sortBtn?.addEventListener('click', () => {
      sortDescending = !sortDescending;
      if (sortLabel && sortIcon) {
        sortLabel.textContent = sortDescending ? 'NEWEST' : 'OLDEST';
        sortIcon.textContent = sortDescending ? '↓' : '↑';
      }
      renderGallery();
    });
  }

  async function initLiveGallery() {
    const loader = document.getElementById('gallery-loader');
    try {
      globalAssets = await getAssets();
      if (loader) loader.remove();
      setupFilters();
      renderGallery();
    } catch (err: unknown) {
      if (loader) {
        const msg = err instanceof Error ? err.message : String(err);
        loader.innerHTML = `<span class="text-rose-400 text-sm font-mono">[!] Live sync failed: ${esc(msg)}</span>`;
      }
    }
  }

  function bindLightboxEvents() {
    const modal = document.getElementById('lightbox-modal');
    const closeBtn = document.getElementById('lightbox-close');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const modalTitle = document.getElementById('lightbox-title');
    const modalSettings = document.getElementById('lightbox-settings');
    const triggers = document.querySelectorAll('.photo-trigger');
    if (!modal || !modalImg) return;

    if (modal.parentElement !== document.body) document.body.appendChild(modal);

    function openModal(imgSrc: string, title: string, settings: string) {
      if (!modalImg) return;
      modalImg.onerror = () => { if (modalTitle) modalTitle.textContent = 'Photo failed to load'; };
      modalImg.src = imgSrc;
      if (modalTitle) modalTitle.textContent = title || '';
      if (modalSettings) modalSettings.textContent = settings || '';
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      setTimeout(() => {
        if (!modal.classList.contains('opacity-0')) return;
        modal.classList.add('hidden');
        if (modalImg) modalImg.src = '';
        document.body.style.overflow = '';
      }, 250);
    }

    triggers.forEach((t) => t.addEventListener('click', () => {
      openModal(t.getAttribute('data-img') || '', t.getAttribute('data-title') || '', t.getAttribute('data-settings') || '');
    }));
    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal || e.target === modal.firstElementChild) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  function setupDispatcherModal() {
    const modal = document.getElementById('dispatch-modal');
    const openBtn = document.getElementById('open-dispatch-btn');
    const closeBtn = document.getElementById('close-dispatch-btn');
    const copyBtn = document.getElementById('copy-email-btn');
    const form = document.getElementById('contact-composer');
    const status = document.getElementById('dispatch-status');
    const targetEmail = 'contact@mvoorhies.com';

    if (!modal || !openBtn) return;
    if (modal.parentElement !== document.body) document.body.appendChild(modal);

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.getElementById('sender-name')?.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', (e) => { e.preventDefault(); openModal(); });
    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(targetEmail);
        copyBtn.textContent = 'COPIED!';
        copyBtn.className = 'self-start sm:self-auto text-[10px] px-2 py-0.5 bg-emerald-950 border border-emerald-700 text-emerald-400 rounded transition';
        setTimeout(() => {
          copyBtn.textContent = 'COPY';
          copyBtn.className = 'self-start sm:self-auto text-[10px] px-2 py-0.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 rounded transition cursor-pointer';
        }, 2000);
      } catch {
        window.location.href = `mailto:${targetEmail}`;
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const sender = (document.getElementById('sender-name') as HTMLInputElement)?.value.trim() || 'Anonymous';
      const subject = (document.getElementById('msg-subject') as HTMLInputElement)?.value.trim() || 'Photo Inquiry';
      const body = (document.getElementById('msg-body') as HTMLTextAreaElement)?.value.trim() || '';

      const formattedBody = `${body}\n\n---\nSent by: ${sender}\nTransmitted from: ${window.location.origin}/photos`;
      const mailtoUri = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(formattedBody)}`;

      if (status) {
        status.textContent = 'Launching email client...';
        status.className = 'text-emerald-400 text-[11px]';
      }
      window.location.href = mailtoUri;
      setTimeout(() => {
        closeModal();
        if (status) {
          status.textContent = 'Ready to transmit.';
          status.className = 'text-slate-500 text-[11px]';
        }
      }, 1200);
    });
  }

  function initPage() {
    initLiveGallery();
    setupDispatcherModal();
  }

  initPage();
  document.addEventListener('astro:after-swap', initPage);
</script>
