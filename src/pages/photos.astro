---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const immichShareKey = import.meta.env.PUBLIC_IMMICH_SHARE_KEY || "";
const immichAlbumId = import.meta.env.PUBLIC_IMMICH_ALBUM_ID || "";
---

<BaseLayout title="Photography & Visual Work" currentPage="photos">
  <header class="mb-8 animate-fade-in max-w-4xl mx-auto">
    <div class="inline-block px-2.5 py-0.5 mb-3 bg-emerald-950/60 border border-emerald-800/60 font-mono text-xs text-emerald-400 rounded">
      PORTFOLIO // LIVE IMMICH ARCHIVE
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3 text-white leading-tight font-mono">
      Photography &amp; Visual Studies
    </h1>
    <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
      A collection of landscape, environmental, and observational photography. Focused on natural textures, low light, and quiet framing.
    </p>
  </header>

  <!-- Live Dynamic Filter Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 p-3 rounded-xl border border-slate-800 bg-slate-900/60 backdrop-blur mb-8 max-w-4xl mx-auto">
    <div id="filter-bar" class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-slate-500 uppercase tracking-wider mr-2">Filter:</span>
      <button data-filter="all" class="filter-btn active px-3 py-1 text-xs font-mono rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 cursor-pointer">
        ALL
      </button>
    </div>
    <div class="flex items-center gap-2 text-xs font-mono text-slate-500">
      <span>SORT:</span>
      <button id="sort-toggle-btn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition cursor-pointer flex items-center gap-1">
        <span id="sort-label">NEWEST</span>
        <span id="sort-icon">&darr;</span>
      </button>
    </div>
  </div>

  <!-- Masonry Gallery (2-Column Max on Desktop) -->
  <section id="gallery-container" class="columns-1 sm:columns-2 max-w-4xl mx-auto gap-6 mb-16 space-y-6">
    <div id="gallery-loader" class="col-span-full py-16 flex flex-col items-center justify-center gap-3 text-slate-400 font-mono text-xs">
      <div class="w-6 h-6 border-2 border-emerald-500/30 border-t-emerald-400 rounded-full animate-spin"></div>
      <span>CONNECTING_TO_IMMICH_ARCHIVE...</span>
    </div>
  </section>

  <!-- Empty Filter State -->
  <div id="gallery-empty" class="hidden py-16 text-center text-slate-500 font-mono text-sm border border-dashed border-slate-800 rounded-xl mb-16 max-w-4xl mx-auto">
    [!] No photos match the active filter criteria.
  </div>

  <!-- Inquiries Banner -->
  <section class="p-6 sm:p-8 bg-slate-900/50 border border-slate-800 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 animate-fade-in delay-200 max-w-4xl mx-auto">
    <div>
      <h3 class="text-base font-semibold text-white mb-1 font-mono">Prints and Inquiries</h3>
      <p class="text-sm text-slate-400 font-sans max-w-xl leading-relaxed">
        Interested in a print or want to say hi? Transmit a dispatch or reach out directly.
      </p>
    </div>
    <button id="open-dispatch-btn" type="button" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-slate-600 text-white text-xs font-mono rounded-lg transition whitespace-nowrap cursor-pointer flex items-center gap-2">
      <span>Get in Touch</span>
      <span>&rarr;</span>
    </button>
  </section>

  <!-- Fullscreen Lightbox -->
  <div id="lightbox-modal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(2, 6, 23, 0.95); backdrop-filter: blur(12px);" class="flex-col justify-between p-4 sm:p-6 select-none">
    <div class="w-full flex justify-between items-center text-xs font-mono text-slate-400 max-w-6xl mx-auto shrink-0">
      <span class="text-emerald-400 tracking-wider">FRAME // TELEMETRY HUD</span>
      <button id="lightbox-close" type="button" class="text-slate-400 hover:text-white bg-slate-900/80 border border-slate-700 px-3 py-1.5 rounded font-mono text-xs transition cursor-pointer">
        &#10005; ESC
      </button>
    </div>

    <div class="flex-1 min-h-0 w-full flex items-center justify-center p-2 my-2 overflow-hidden">
      <img id="lightbox-img" src="" alt="" draggable="false" oncontextmenu="return false;"
        class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg shadow-2xl pointer-events-none select-none border border-slate-800/80" />
    </div>

    <div class="w-full max-w-4xl mx-auto bg-slate-950/90 border border-slate-800 rounded-xl p-3 sm:p-4 font-mono text-xs text-slate-300 shrink-0 backdrop-blur">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-2 pb-2 border-b border-slate-800/80">
        <div>
          <span id="lightbox-title" class="text-white font-bold text-sm block"></span>
          <span id="lightbox-device" class="text-slate-500 text-[11px]"></span>
        </div>
        <div class="flex items-center gap-3">
          <span id="lightbox-date" class="text-slate-500 text-[11px]"></span>
          <button id="lightbox-like-btn" type="button" class="px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-slate-300 transition flex items-center gap-1.5 cursor-pointer">
            <span class="heart-icon text-rose-500">&hearts;</span>
            <span class="like-label">LIKE</span>
          </button>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px]">
        <div id="lightbox-settings" class="text-emerald-400"></div>
        <div id="lightbox-tags" class="flex flex-wrap gap-1.5"></div>
      </div>
    </div>
  </div>

  <!-- Terminal Dispatcher Modal with Turnstile Gatekeeper -->
  <div id="dispatch-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-xl rounded-xl shadow-2xl overflow-hidden font-mono text-xs flex flex-col animate-fade-in">
      <div class="bg-slate-950 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-slate-400">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 text-slate-300">comms_dispatcher.sh</span>
        </div>
        <button id="close-dispatch-btn" type="button" class="text-slate-500 hover:text-white transition cursor-pointer">ESC</button>
      </div>

      <!-- GATEKEEPER: Captcha Check First -->
      <div id="photos-gatekeeper" class="p-8 flex flex-col items-center justify-center text-center space-y-4">
        <div class="inline-block px-2.5 py-0.5 bg-emerald-950/60 border border-emerald-800/60 text-emerald-400 text-[11px] rounded">
          ❯ CLOUDFLARE_EDGE_VERIFICATION
        </div>
        <h3 class="text-base font-bold text-white">Bot Protection Check</h3>
        <p class="text-xs text-slate-400 max-w-xs leading-relaxed font-sans">
          Complete the verification below to unlock direct communication channels and open the dispatch console.
        </p>
        <div class="py-2 min-h-[65px] flex items-center justify-center">
          <div id="photos-turnstile-container"></div>
        </div>
        <span id="photos-gatekeeper-status" class="text-slate-500 text-[11px]">
          Waiting for challenge response...
        </span>
      </div>

      <!-- COMPOSER: Unlocks only after Turnstile completes -->
      <div id="photos-composer-stage" class="hidden flex-col">
        <!-- Direct Email Bar with Concealed Address until Verified -->
        <div class="bg-slate-950/60 border-b border-slate-800/80 px-5 py-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 overflow-hidden">
            <span class="text-emerald-400 font-semibold uppercase text-[10px] sm:text-xs shrink-0">[DIRECT]</span>
            <span id="photos-unlocked-email" class="text-slate-300 truncate font-mono select-all"></span>
          </div>
          <button 
            id="copy-email-btn" 
            type="button" 
            class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded text-[10px] transition shrink-0 cursor-pointer"
          >
            COPY
          </button>
        </div>

        <form id="contact-composer" class="p-5 space-y-4">
          <div>
            <label for="sender-name" class="block text-slate-400 mb-1 text-[11px]">
              <span class="text-emerald-400">01.</span> SENDER_IDENTITY:
            </label>
            <input type="text" id="sender-name" required placeholder="Name or Handle" class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition" />
          </div>
          <div>
            <label for="msg-subject" class="block text-slate-400 mb-1 text-[11px]">
              <span class="text-emerald-400">02.</span> DISPATCH_SUBJECT:
            </label>
            <input type="text" id="msg-subject" required value="Photography / Print Inquiry" class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition" />
          </div>
          <div>
            <label for="msg-body" class="block text-slate-400 mb-1 text-[11px]">
              <span class="text-emerald-400">03.</span> MESSAGE_PAYLOAD:
            </label>
            <textarea id="msg-body" rows="4" required placeholder="Inquiry or message details..." class="w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500/80 transition resize-none"></textarea>
          </div>
          <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-t border-slate-800/60">
            <span id="dispatch-status" class="text-emerald-400 text-[11px]">Ready to transmit.</span>
            <button type="submit" class="px-4 py-2 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800 text-emerald-400 rounded transition duration-150 flex items-center gap-2 cursor-pointer font-bold">
              <span>TRANSMIT DISPATCH</span>
              <span>❯</span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ siteKey, immichShareKey, immichAlbumId }}>
  var SHARE_KEY = immichShareKey;
  var ALBUM_ID = immichAlbumId;
  var LIKES_KEY = 'mvoorhies_photo_likes';
  var ENCODED_INBOX = "Y29udGFjdEBtdm9vcmhpZXMuY29t";

  var globalAssets = [];
  var currentFilter = 'all';
  var sortDescending = true;
  var activeLightboxAsset = null;

  var turnstileWidgetId = null;
  var verifiedToken = null;
  var resolvedEmail = null;

  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function getLikedIds() {
    try {
      var stored = JSON.parse(localStorage.getItem(LIKES_KEY) || '[]');
      return new Set(Array.isArray(stored) ? stored : []);
    } catch (e) {
      return new Set();
    }
  }

  function toggleLike(id) {
    var likes = getLikedIds();
    var isLiked = false;
    if (likes.has(id)) {
      likes.delete(id);
      isLiked = false;
    } else {
      likes.add(id);
      isLiked = true;
    }
    localStorage.setItem(LIKES_KEY, JSON.stringify(Array.from(likes)));
    updateCardLikeState(id, isLiked);
    return isLiked;
  }

  function updateCardLikeState(assetId, isLiked) {
    document.querySelectorAll('.like-btn[data-id="' + assetId + '"]').forEach(function(btn) {
      btn.className = isLiked 
        ? 'like-btn px-2 py-0.5 rounded transition flex items-center gap-1 cursor-pointer text-rose-400 bg-rose-950/40 border border-rose-800/50'
        : 'like-btn px-2 py-0.5 rounded transition flex items-center gap-1 cursor-pointer text-slate-500 hover:text-slate-300';
      btn.innerHTML = '<span class="heart-symbol text-xs">' + (isLiked ? '&hearts;' : '&#9825;') + '</span><span class="text-[10px]">' + (isLiked ? 'LIKED' : 'LIKE') + '</span>';
    });

    var lightboxBtn = document.getElementById('lightbox-like-btn');
    if (lightboxBtn && activeLightboxAsset && activeLightboxAsset.id === assetId) {
      lightboxBtn.className = isLiked 
        ? 'px-2.5 py-1 rounded bg-rose-950/40 border border-rose-700 text-rose-400 transition flex items-center gap-1.5 cursor-pointer'
        : 'px-2.5 py-1 rounded bg-slate-900 border border-slate-700 hover:border-slate-500 text-slate-300 transition flex items-center gap-1.5 cursor-pointer';
      lightboxBtn.innerHTML = '<span class="heart-icon">' + (isLiked ? '&hearts;' : '&#9825;') + '</span><span class="like-label">' + (isLiked ? 'LIKED' : 'LIKE') + '</span>';
    }
  }

  function formatRelativeDate(isoDateStr) {
    if (!isoDateStr) return 'Recently';
    var d = new Date(isoDateStr);
    if (isNaN(d.getTime())) return isoDateStr;
    var diff = (Date.now() - d.getTime()) / 1000;
    if (diff < 86400) return 'Today';
    var days = Math.floor(diff / 86400);
    if (days === 1) return 'Yesterday';
    if (days < 30) return days + 'd ago';
    var months = Math.floor(days / 30);
    if (months < 12) return months + 'mo ago';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short' });
  }

  async function getAssets() {
    try {
      var res = await fetch('/immich-api/search/metadata?key=' + encodeURIComponent(SHARE_KEY), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ albumIds: [ALBUM_ID], size: 250, withExif: true })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      var raw = (data.assets && data.assets.items) ? data.assets.items : [];

      return raw
        .filter(function(a) { return !a.type || a.type === 'IMAGE'; })
        .map(function(a) {
          var exif = a.exifInfo || {};
          return {
            id: a.id,
            date: a.fileCreatedAt || a.localDateTime || '',
            exif: {
              lensModel: exif.lensModel,
              make: exif.make,
              model: exif.model,
              fNumber: exif.fNumber,
              exposureTime: exif.exposureTime,
              iso: exif.iso,
              description: exif.description || '',
              focalLength: exif.focalLength
            }
          };
        });
    } catch (err) {
      console.error('Immich fetch error:', err);
      return [];
    }
  }

  function renderGallery() {
    var container = document.getElementById('gallery-container');
    var emptyState = document.getElementById('gallery-empty');
    if (!container) return;

    var userLikes = getLikedIds();
    var filtered = globalAssets.slice();
    if (currentFilter !== 'all') {
      filtered = filtered.filter(function(asset) {
        var desc = (asset.exif && asset.exif.description) ? asset.exif.description : '';
        var tags = (desc.match(/#[a-z0-9_-]+/gi) || []).map(function(t) { return t.slice(1).toLowerCase(); });
        var fullCam = (((asset.exif && asset.exif.make) || '') + ' ' + ((asset.exif && asset.exif.model) || '')).toLowerCase();
        if (fullCam.indexOf('canon') !== -1) tags.push('canon');
        if (fullCam.indexOf('samsung') !== -1 || fullCam.indexOf('galaxy') !== -1) tags.push('samsung');
        return tags.indexOf(currentFilter.toLowerCase()) !== -1;
      });
    }

    filtered.sort(function(a, b) {
      var cmp = (b.date || '').localeCompare(a.date || '');
      return sortDescending ? cmp : -cmp;
    });

    if (filtered.length === 0) {
      container.innerHTML = '';
      if (emptyState) emptyState.classList.remove('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');

    container.innerHTML = filtered.map(function(asset) {
      var thumbUrl = '/immich-api/assets/' + asset.id + '/thumbnail?size=preview&key=' + encodeURIComponent(SHARE_KEY);
      var exif = asset.exif || {};
      var lens = exif.lensModel || '';
      var make = (exif.make || '').trim();
      var rawModel = (exif.model || '').trim();
      var cleanMake = make ? make.charAt(0).toUpperCase() + make.slice(1) : '';
      var camera = 'Digital Capture';
      if (rawModel) {
        camera = rawModel.toLowerCase().indexOf(cleanMake.toLowerCase()) === 0
          ? rawModel
          : [cleanMake, rawModel].filter(Boolean).join(' ');
      } else if (cleanMake) {
        camera = cleanMake;
      }

      var isPhoneLens = /wide-angle|telephoto|ultra-wide/i.test(lens);
      var desc = exif.description || '';
      var tags = (desc.match(/#[a-z0-9_-]+/gi) || []).map(function(t) { return t.slice(1).toUpperCase(); });
      var fullCam = (make + ' ' + rawModel).toLowerCase();
      if (fullCam.indexOf('canon') !== -1) {
        if (tags.indexOf('CANON') === -1) tags.push('CANON');
      } else if (fullCam.indexOf('samsung') !== -1 || fullCam.indexOf('galaxy') !== -1) {
        if (tags.indexOf('SAMSUNG') === -1) tags.push('SAMSUNG');
      }

      var landmarkTag = tags.find(function(t) {
        return ['CANON', 'SAMSUNG', 'APPLE', 'SONY', 'NIKON', 'LANDSCAPE', 'PORTRAIT', 'NIGHT', 'MACRO'].indexOf(t) === -1;
      });
      var displayTitle = landmarkTag ? landmarkTag.replace(/_/g, ' ') : (lens && !isPhoneLens ? lens : (desc ? desc.replace(/#[a-z0-9_-]+/gi, '').trim() : camera));

      var fStop = exif.fNumber ? ('f/' + exif.fNumber) : '';
      var shutter = exif.exposureTime ? (exif.exposureTime + 's') : '';
      var iso = exif.iso ? ('ISO ' + exif.iso) : '';
      var settings = [fStop, shutter, iso].filter(Boolean).join('  ·  ');
      var timeAgo = formatRelativeDate(asset.date);
      var isLiked = userLikes.has(asset.id);

      return '' +
        '<article class="photo-card break-inside-avoid mb-6 p-4 sm:p-5 bg-slate-900/60 border border-slate-800/90 rounded-2xl hover:border-slate-700 transition duration-300 animate-fade-in flex flex-col justify-between group">' +
          '<button type="button" class="photo-trigger w-full overflow-hidden bg-slate-950 block rounded-xl mb-3 relative cursor-zoom-in text-left focus:outline-none" data-id="' + asset.id + '" title="Click to view full photograph & telemetry">' +
            '<img src="' + esc(thumbUrl) + '" alt="' + esc(displayTitle) + '" loading="lazy" draggable="false" oncontextmenu="return false;" class="w-full h-auto object-cover rounded-xl group-hover:scale-[1.01] transition-transform duration-300 pointer-events-none select-none" />' +
            '<div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4 rounded-xl">' +
              '<span class="text-xs text-white bg-slate-900/80 backdrop-blur px-2.5 py-1 rounded-md border border-slate-700 font-mono">View Photo &amp; Telemetry ↗</span>' +
            '</div>' +
          '</button>' +
          '<div class="space-y-3 font-mono">' +
            '<div class="flex justify-between items-baseline gap-2">' +
              '<span class="text-xs font-semibold text-slate-100 truncate">' + esc(displayTitle) + '</span>' +
              '<span class="text-[10px] text-slate-500 whitespace-nowrap">' + timeAgo + '</span>' +
            '</div>' +
            '<div class="flex flex-wrap gap-1.5">' +
              tags.map(function(t) { return '<span class="px-2 py-0.5 text-[9px] uppercase rounded bg-slate-800/80 text-slate-400 border border-slate-700/80">' + esc(t) + '</span>'; }).join('') +
            '</div>' +
            '<div class="flex justify-between items-center text-[11px] text-slate-500 pt-2 border-t border-slate-800/60">' +
              '<span class="text-slate-400">' + esc(camera) + '</span>' +
              '<button type="button" class="like-btn px-2 py-0.5 rounded transition flex items-center gap-1 cursor-pointer ' + (isLiked ? 'text-rose-400 bg-rose-950/40 border border-rose-800/50' : 'text-slate-500 hover:text-slate-300') + '" data-id="' + asset.id + '" title="Heart this photograph">' +
                '<span class="heart-symbol text-xs">' + (isLiked ? '&hearts;' : '&#9825;') + '</span>' +
                '<span class="text-[10px]">' + (isLiked ? 'LIKED' : 'LIKE') + '</span>' +
              '</button>' +
            '</div>' +
          '</div>' +
        '</article>';
    }).join('');

    bindInteractiveEvents();
  }

  function buildFilterButtons(allTags) {
    var filterBar = document.getElementById('filter-bar');
    if (!filterBar) return;

    filterBar.querySelectorAll('.dynamic-tag-btn').forEach(function(b) { b.remove(); });

    allTags.forEach(function(tag) {
      var btn = document.createElement('button');
      btn.setAttribute('data-filter', tag.toLowerCase());
      btn.className = 'filter-btn dynamic-tag-btn px-3 py-1 text-xs font-mono rounded bg-slate-800/60 text-slate-400 border border-slate-700 hover:text-white transition-colors uppercase cursor-pointer';
      btn.textContent = tag;
      filterBar.appendChild(btn);
    });

    var buttons = document.querySelectorAll('.filter-btn');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) {
          b.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
          b.classList.add('bg-slate-800/60', 'text-slate-400', 'border-slate-700');
        });
        btn.classList.add('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
        btn.classList.remove('bg-slate-800/60', 'text-slate-400', 'border-slate-700');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        renderGallery();
      });
    });
  }

  function bindInteractiveEvents() {
    document.querySelectorAll('.like-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = btn.getAttribute('data-id');
        if (id) toggleLike(id);
      });
    });

    document.querySelectorAll('.photo-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        var id = trigger.getAttribute('data-id');
        var asset = globalAssets.find(function(a) { return a.id === id; });
        if (asset) openLightbox(asset);
      });
    });
  }

  function openLightbox(asset) {
    activeLightboxAsset = asset;
    var modal = document.getElementById('lightbox-modal');
    var modalImg = document.getElementById('lightbox-img');
    var modalTitle = document.getElementById('lightbox-title');
    var modalDevice = document.getElementById('lightbox-device');
    var modalDate = document.getElementById('lightbox-date');
    var modalSettings = document.getElementById('lightbox-settings');
    var modalTags = document.getElementById('lightbox-tags');
    var likeBtn = document.getElementById('lightbox-like-btn');
    if (!modal || !modalImg) return;

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    var exif = asset.exif || {};
    var make = (exif.make || '').trim();
    var rawModel = (exif.model || '').trim();
    var cleanMake = make ? make.charAt(0).toUpperCase() + make.slice(1) : '';
    var camera = rawModel 
      ? (rawModel.toLowerCase().indexOf(cleanMake.toLowerCase()) === 0 ? rawModel : [cleanMake, rawModel].filter(Boolean).join(' '))
      : (cleanMake || 'Digital Capture');

    var desc = exif.description || '';
    var tags = (desc.match(/#[a-z0-9_-]+/gi) || []).map(function(t) { return t.slice(1).toUpperCase(); });
    var landmarkTag = tags.find(function(t) {
      return ['CANON', 'SAMSUNG', 'APPLE', 'SONY', 'NIKON', 'LANDSCAPE', 'PORTRAIT', 'NIGHT', 'MACRO'].indexOf(t) === -1;
    });
    var title = landmarkTag ? landmarkTag.replace(/_/g, ' ') : (exif.lensModel || camera);

    var fStop = exif.fNumber ? ('f/' + exif.fNumber) : '';
    var shutter = exif.exposureTime ? (exif.exposureTime + 's') : '';
    var iso = exif.iso ? ('ISO ' + exif.iso) : '';
    var focal = exif.focalLength ? (exif.focalLength + 'mm') : '';
    var settings = [focal, fStop, shutter, iso].filter(Boolean).join('  ·  ');

    var thumbUrl = '/immich-api/assets/' + asset.id + '/thumbnail?size=preview&key=' + encodeURIComponent(SHARE_KEY);
    modalImg.src = thumbUrl;
    if (modalTitle) modalTitle.textContent = title;
    if (modalDevice) modalDevice.textContent = camera + (exif.lensModel ? (' • ' + exif.lensModel) : '');
    if (modalDate) modalDate.textContent = asset.date ? new Date(asset.date).toLocaleDateString(undefined, { dateStyle: 'medium' }) : '';
    if (modalSettings) modalSettings.innerHTML = settings ? ('<span class="bg-emerald-950/60 px-2.5 py-1 rounded border border-emerald-900/60">' + settings + '</span>') : '';
    if (modalTags) {
      modalTags.innerHTML = tags.map(function(t) { return '<span class="px-2 py-0.5 text-[9px] uppercase rounded bg-slate-900 text-slate-400 border border-slate-800">#' + esc(t) + '</span>'; }).join('');
    }

    var isLiked = getLikedIds().has(asset.id);
    if (likeBtn) {
      likeBtn.className = isLiked 
        ? 'px-2.5 py-1 rounded bg-rose-950/40 border border-rose-700 text-rose-400 transition flex items-center gap-1.5 cursor-pointer'
        : 'px-2.5 py-1 rounded bg-slate-900 border border-slate-700 hover:border-slate-500 text-slate-300 transition flex items-center gap-1.5 cursor-pointer';
      likeBtn.innerHTML = '<span class="heart-icon">' + (isLiked ? '&hearts;' : '&#9825;') + '</span><span class="like-label">' + (isLiked ? 'LIKED' : 'LIKE') + '</span>';
    }

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    var modal = document.getElementById('lightbox-modal');
    if (!modal) return;
    modal.style.display = 'none';
    var img = document.getElementById('lightbox-img');
    if (img) img.src = '';
    document.body.style.overflow = '';
    activeLightboxAsset = null;
  }

  function initPhotosTurnstile() {
    var container = document.getElementById('photos-turnstile-container');
    var status = document.getElementById('photos-gatekeeper-status');

    if (!container || !window.turnstile) return;

    if (turnstileWidgetId !== null) {
      window.turnstile.reset(turnstileWidgetId);
      return;
    }

    turnstileWidgetId = window.turnstile.render('#photos-turnstile-container', {
      sitekey: siteKey,
      theme: 'dark',
      callback: function(token) {
        verifiedToken = token;
        resolvedEmail = atob(ENCODED_INBOX);

        if (status) {
          status.textContent = "Challenge verified. Unlocking dispatch console...";
          status.className = "text-emerald-400 text-[11px]";
        }

        setTimeout(function() {
          var gatekeeper = document.getElementById('photos-gatekeeper');
          var composer = document.getElementById('photos-composer-stage');
          var emailDisplay = document.getElementById('photos-unlocked-email');

          if (gatekeeper) gatekeeper.classList.add('hidden');
          if (composer) {
            composer.classList.remove('hidden');
            composer.classList.add('flex');
          }
          if (emailDisplay) {
            emailDisplay.textContent = resolvedEmail;
          }
          document.getElementById('sender-name')?.focus();
        }, 350);
      },
      'expired-callback': function() {
        verifiedToken = null;
        resolvedEmail = null;
        var gatekeeper = document.getElementById('photos-gatekeeper');
        var composer = document.getElementById('photos-composer-stage');
        if (gatekeeper) gatekeeper.classList.remove('hidden');
        if (composer) {
          composer.classList.add('hidden');
          composer.classList.remove('flex');
        }
        if (status) {
          status.textContent = "Session expired. Please reverify.";
          status.className = "text-amber-400 text-[11px]";
        }
      }
    });
  }

  function setupDispatcherModal() {
    var modal = document.getElementById('dispatch-modal');
    var openBtn = document.getElementById('open-dispatch-btn');
    var closeBtn = document.getElementById('close-dispatch-btn');
    var copyBtn = document.getElementById('copy-email-btn');
    var form = document.getElementById('contact-composer');
    var status = document.getElementById('dispatch-status');

    if (!modal || !openBtn) return;

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      if (!verifiedToken) {
        var gatekeeper = document.getElementById('photos-gatekeeper');
        var composer = document.getElementById('photos-composer-stage');
        if (gatekeeper) gatekeeper.classList.remove('hidden');
        if (composer) {
          composer.classList.add('hidden');
          composer.classList.remove('flex');
        }

        if (window.turnstile) {
          initPhotosTurnstile();
        } else {
          var check = setInterval(function() {
            if (window.turnstile) {
              clearInterval(check);
              initPhotosTurnstile();
            }
          }, 100);
        }
      }
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', function(e) {
      e.preventDefault();
      openModal();
    });

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    copyBtn?.addEventListener('click', async function() {
      if (!resolvedEmail) return;
      try {
        await navigator.clipboard.writeText(resolvedEmail);
        copyBtn.textContent = 'COPIED!';
        copyBtn.className = 'px-2.5 py-1 bg-emerald-950 border border-emerald-600 text-emerald-400 rounded text-[10px] transition shrink-0 cursor-pointer';
        setTimeout(function() {
          copyBtn.textContent = 'COPY';
          copyBtn.className = 'px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded text-[10px] transition shrink-0 cursor-pointer';
        }, 2000);
      } catch (err) {
        window.location.href = 'mailto:' + resolvedEmail;
      }
    });

    form?.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!verifiedToken || !resolvedEmail) return;

      var sender = (document.getElementById('sender-name'))?.value.trim() || 'Anonymous';
      var subject = (document.getElementById('msg-subject'))?.value.trim() || 'Photo Inquiry';
      var body = (document.getElementById('msg-body'))?.value.trim() || '';

      var formattedBody = body + '\n\n---\nSent by: ' + sender + '\nTransmitted from: ' + window.location.origin + '/photos\nCF-Turnstile: [Verified: ' + verifiedToken.slice(0, 16) + '...]';
      var mailtoUri = 'mailto:' + resolvedEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(formattedBody);

      if (status) {
        status.textContent = 'Launching email client...';
        status.className = 'text-emerald-400 text-[11px]';
      }

      window.location.href = mailtoUri;

      setTimeout(function() {
        closeModal();
        if (status) {
          status.textContent = 'Ready to transmit.';
          status.className = 'text-slate-500 text-[11px]';
        }
      }, 1200);
    });
  }

  async function initLiveGallery() {
    var loader = document.getElementById('gallery-loader');
    var sortBtn = document.getElementById('sort-toggle-btn');
    var sortLabel = document.getElementById('sort-label');
    var sortIcon = document.getElementById('sort-icon');

    try {
      globalAssets = await getAssets();
      if (loader) loader.remove();

      var allFoundTags = new Set();
      globalAssets.forEach(function(asset) {
        var desc = (asset.exif && asset.exif.description) ? asset.exif.description : '';
        var tags = (desc.match(/#[a-z0-9_-]+/gi) || []).map(function(t) { return t.slice(1).toUpperCase(); });
        var fullCam = (((asset.exif && asset.exif.make) || '') + ' ' + ((asset.exif && asset.exif.model) || '')).toLowerCase();
        if (fullCam.indexOf('canon') !== -1) allFoundTags.add('CANON');
        if (fullCam.indexOf('samsung') !== -1 || fullCam.indexOf('galaxy') !== -1) allFoundTags.add('SAMSUNG');
        tags.forEach(function(t) { allFoundTags.add(t); });
      });

      buildFilterButtons(allFoundTags);
      renderGallery();

      sortBtn?.addEventListener('click', function() {
        sortDescending = !sortDescending;
        if (sortLabel && sortIcon) {
          sortLabel.textContent = sortDescending ? 'NEWEST' : 'OLDEST';
          sortIcon.textContent = sortDescending ? '↓' : '↑';
        }
        renderGallery();
      });

      document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
      document.getElementById('lightbox-modal')?.addEventListener('click', function(e) {
        if (e.target === document.getElementById('lightbox-modal')) closeLightbox();
      });
      document.getElementById('lightbox-like-btn')?.addEventListener('click', function() {
        if (activeLightboxAsset) toggleLike(activeLightboxAsset.id);
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });
    } catch (err) {
      if (loader) loader.innerHTML = '<span class="text-rose-400 font-mono text-xs">[!] Telemetry offline</span>';
    }
  }

  function initPage() {
    initLiveGallery();
    setupDispatcherModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
  document.addEventListener('astro:after-swap', initPage);
</script>
