---
import BaseLayout from '../layouts/BaseLayout.astro';

const badges = {
  secPlus: {
    title: "CompTIA Security+ ce",
    desc: "Threat Defense & Access Controls",
    url: "https://www.credly.com/badges/146eb28d-2112-4781-99f9-a2060cad983b",
    type: "verified"
  },
  netPlus: {
    title: "CompTIA Network+ ce",
    desc: "Topologies, Routing & Protocols",
    url: "https://www.credly.com/badges/6f6ad808-b045-4b63-bcae-1e42cd879bcd",
    type: "verified"
  },
  aPlus: {
    title: "CompTIA A+ ce",
    desc: "Systems & Hardware Operations",
    url: "https://www.credly.com/badges/55ba9400-b763-4ede-a1e3-71b5eb70ff20",
    type: "verified"
  },
  csis: {
    title: "CompTIA CSIS",
    desc: "Secure Infrastructure Specialist",
    url: "https://www.credly.com/badges/2b56ea22-d17b-4135-8636-39589c28cf5e",
    type: "stackable"
  },
  cios: {
    title: "CompTIA CIOS",
    desc: "IT Operations Specialist",
    url: "https://www.credly.com/badges/57e8a8a4-713c-432f-87b3-0b9df7f72249",
    type: "stackable"
  },
  googleIbm: {
    title: "Google & IBM Tracks",
    desc: "IT Support, Cyber & Automation",
    url: "https://www.credly.com/users/michaelvoorhies",
    type: "external"
  }
};

const siteKey = "0x4AAAAAAFXv8I1L-ZUo5LD1";
---
<BaseLayout title="Resume" currentPage="resume" description="Curriculum Vitae: Systems Administration, Hardware Diagnostics, Networking, and Security Credentials.">
  
  <div class="resume-wrapper">
    
    <!-- Action Bar (VISIBLE ON-SCREEN, HIDDEN IN PRINT & PDF) -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 print:hidden border-b border-slate-800/80 pb-4">
      <div>
        <div class="inline-block px-2.5 py-0.5 mb-2 bg-emerald-950/60 border border-emerald-800/60 font-mono text-xs text-emerald-400 rounded">
          ❯ CURRICULUM_VITAE // SYS_INFRA_SECURITY
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-mono">Michael Voorhies</h1>
        
        <!-- Turnstile-Gated Contact Line -->
        <div class="text-slate-400 text-sm mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono">
          <span>Systems, Networking & Defensive Security • Indiana, PA •</span>
          
          <!-- Verification Button (Hidden once verified) -->
          <span id="email-gate-container" class="inline-flex items-center">
            <button 
              id="trigger-turnstile-btn"
              type="button"
              class="text-xs text-emerald-400 bg-emerald-950/60 hover:bg-emerald-900 border border-emerald-800/80 px-2 py-0.5 rounded cursor-pointer transition flex items-center gap-1"
            >
              <span>[VERIFY TO REVEAL EMAIL]</span>
            </button>
          </span>

          <!-- Revealed Email Link -->
          <span id="email-revealed" class="hidden text-emerald-400">
            <a id="email-link" href="#" class="hover:underline"></a>
          </span>

          <span>• <a href="https://mvoorhies.com" class="text-slate-300 hover:text-emerald-400 hover:underline">mvoorhies.com</a></span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto font-mono text-xs">
        <a 
          href="/resume.md" 
          target="_blank"
          class="px-3 py-2 bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 rounded transition flex items-center gap-1.5"
          title="View Plaintext Markdown Resume Buffer"
        >
          <span>[RAW .MD]</span>
        </a>
        <button 
          id="resume-print-btn"
          type="button"
          class="px-4 py-2 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800 text-emerald-400 rounded transition flex items-center gap-2 cursor-pointer shadow-lg active:scale-95"
        >
          <span>[🖨️ / ⬇️]</span>
          <span>Save as PDF / Print</span>
        </button>
      </div>
    </div>

    <!-- Printable Resume Body Target -->
    <div id="resume-container" class="text-slate-100 bg-transparent font-sans">
      
      <!-- Print-Only Header Strip (VISIBLE ONLY IN PRINT / PDF) -->
      <div class="hidden print:block border-b-2 border-black pb-3 mb-4">
        <h1 class="text-2xl font-bold uppercase tracking-tight text-black font-sans">Michael Voorhies</h1>
        <p class="text-xs text-black mt-1 font-sans">
          Indiana, PA • <span id="print-email-target">contact@mvoorhies.com</span> • <a href="https://mvoorhies.com">https://mvoorhies.com</a> • <a href="https://www.credly.com/users/michaelvoorhies">https://www.credly.com/users/michaelvoorhies</a>
        </p>
      </div>

      <!-- Technical Profile -->
      <section class="resume-section mb-6 print:mb-3">
        <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2 print:border-b print:border-black print:pb-0.5">// Technical Profile</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed resume-text">
          Technologist combining hands-on PC hardware diagnostics, physical structured cabling, and self-hosted infrastructure administration with an academic foundation in Criminology and regulatory compliance. Holds the CompTIA Security Trifecta (Security+, Network+, A+) alongside stackable CIOS and CSIS credentials. Experienced in configuring Role-Based Access Controls (RBAC), deploying containerized environments, and diagnosing bare-metal hardware and network systems.
        </p>
      </section>

      <!-- Certifications & Credentials Grid -->
      <section class="resume-section mb-6 print:mb-3">
        <div class="flex justify-between items-baseline mb-2.5 print:mb-1">
          <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider print:border-b print:border-black print:pb-0.5 w-full">// Certifications & Industry Credentials</h2>
          <a 
            href="https://www.credly.com/users/michaelvoorhies" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-mono text-slate-400 hover:text-emerald-400 print:hidden transition whitespace-nowrap ml-4"
          >
            [View Full Credly Profile ↗]
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 print:grid-cols-3 print:gap-1.5">
          
          {Object.entries(badges).map(([key, item]) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="resume-box p-3 bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-emerald-700/80 rounded transition group block relative overflow-hidden"
            >
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-white group-hover:text-emerald-400 text-xs font-mono resume-title flex items-center gap-1.5">
                  <span>{item.title}</span>
                </span>
                
                {item.type === 'verified' && (
                  <span class="text-[10px] font-mono text-emerald-400/90 bg-emerald-950/80 border border-emerald-800/60 px-1.5 py-0.2 rounded print:hidden flex items-center gap-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span> VERIFIED
                  </span>
                )}
                {item.type === 'stackable' && (
                  <span class="text-[10px] font-mono text-cyan-400/90 bg-cyan-950/80 border border-cyan-800/60 px-1.5 py-0.2 rounded print:hidden">
                    STACKABLE
                  </span>
                )}
                {item.type === 'external' && (
                  <span class="text-[10px] font-mono text-slate-400 bg-slate-800 px-1.5 py-0.2 rounded print:hidden">
                    BADGES ↗
                  </span>
                )}
              </div>
              <div class="text-[11px] text-slate-400 resume-desc">{item.desc}</div>
            </a>
          ))}

        </div>
      </section>

      <!-- Technical Proficiencies Matrix -->
      <section class="resume-section mb-6 print:mb-3">
        <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2 print:border-b print:border-black print:pb-0.5">// Technical Proficiencies</h2>
        <div class="space-y-1.5 text-xs sm:text-sm text-slate-300 leading-relaxed resume-text">
          <p><strong class="text-white font-semibold">Systems & OS Administration:</strong> Windows Server (Active Directory, Group Policy Objects), Windows 10/11, Linux (Debian, Ubuntu), macOS, Bare-Metal OS Deployment, Disk Partitioning/Imaging, System Recovery.</p>
          <p><strong class="text-white font-semibold">Hardware & Physical Cabling:</strong> Component-Level Bench Architecture, POST Diagnostics, Structured Cabling (Cat5e/Cat6 Termination, T568B Standards, 110 Keystone Jacks, Continuity Testing).</p>
          <p><strong class="text-white font-semibold">Identity, Access & Cloud:</strong> Authentik IdP, Single Sign-On (SSO), Multi-Factor Authentication (MFA), OAuth2 / OIDC, SAML 2.0, Cloudflare Zero Trust (Tunnels & Access Control), RBAC.</p>
          <p><strong class="text-white font-semibold">Containers & Virtualization:</strong> Proxmox VE, Docker & Docker Compose, Portainer, Reverse Proxies (Nginx), Pi-hole (DNS Sinkhole), Uptime Kuma Monitoring.</p>
          <p><strong class="text-white font-semibold">Investigation & Compliance:</strong> Investigative evidence integrity, audit log verification, MITRE ATT&CK mapping, HIPAA & regulatory standards awareness.</p>
        </div>
      </section>

      <!-- Technical Infrastructure & Labs -->
      <section class="resume-section mb-6 print:mb-3">
        <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2 print:border-b print:border-black print:pb-0.5">// Technical Infrastructure & Practical Labs</h2>
        <div class="space-y-3 print:space-y-2 text-xs sm:text-sm">
          
          <!-- Homelab Card -->
          <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-1">
              <span class="font-bold text-white resume-title">Self-Hosted Infrastructure & Identity Administration</span>
              <span class="text-xs font-mono text-emerald-400 font-medium resume-badge">[Personal Lab]</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed resume-desc mb-2">
              Maintained containerized services via Docker and Proxmox VE. Configured Authentik for centralized Identity Management (SSO/MFA) via OIDC/SAML, routed external endpoints through encrypted Cloudflare Zero Trust Tunnels without open firewall ports, and enforced network-level DNS filtering using Pi-hole.
            </p>
            
            <details class="print:hidden text-xs font-mono bg-slate-950/70 border border-slate-800/80 rounded p-2 text-slate-300 cursor-pointer">
              <summary class="text-emerald-400 hover:text-emerald-300 font-semibold transition">
                ❯ [VIEW TOPOLOGY & SPEC]
              </summary>
              <div class="mt-2 space-y-1 text-[11px] text-slate-400 border-t border-slate-800/60 pt-2">
                <p>• <span class="text-slate-200">Hypervisor:</span> Proxmox VE 8.x • Unprivileged Debian 12 LXC Containers</p>
                <p>• <span class="text-slate-200">Identity:</span> Authentik IdP (OAuth2/OIDC, SAML 2.0, Multi-Factor Auth)</p>
                <p>• <span class="text-slate-200">Edge Routing:</span> Cloudflare Zero Trust (cloudflared tunnels) • Nginx Reverse Proxy</p>
                <p>• <span class="text-slate-200">Defensive DNS:</span> Pi-hole Recursive Sinkhole • Uptime Kuma Telemetry Monitors</p>
              </div>
            </details>
          </div>

          <!-- ICTC Bench Card -->
          <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-1">
              <span class="font-bold text-white resume-title">Hardware Diagnostics & Enterprise Systems Bench</span>
              <span class="text-xs font-mono text-blue-400 font-medium resume-badge">[ICTC Lab Training]</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed resume-desc mb-2">
              Executed component-level hardware triage, POST error isolation, and custom PC builds. Terminated Cat6 network runs to keystone jacks and patch panels, configured Windows Server Active Directory organizational units and Group Policy Objects, and managed bare-metal OS flashing and disk recovery.
            </p>
            
            <details class="print:hidden text-xs font-mono bg-slate-950/70 border border-slate-800/80 rounded p-2 text-slate-300 cursor-pointer">
              <summary class="text-blue-400 hover:text-blue-300 font-semibold transition">
                ❯ [VIEW BENCH DIAGNOSTICS & TOOLS]
              </summary>
              <div class="mt-2 space-y-1 text-[11px] text-slate-400 border-t border-slate-800/60 pt-2">
                <p>• <span class="text-slate-200">Structured Cabling:</span> Cat5e/Cat6 Termination • T568B Standard • 110 Punch-down • Continuity Testers</p>
                <p>• <span class="text-slate-200">Hardware Triage:</span> Motherboard POST Debugging • RAM/PCIe Seating • Thermal Paste Application</p>
                <p>• <span class="text-slate-200">Directory Services:</span> Windows Server 2022 • Active Directory Domain Services (AD DS) • OUs & GPOs</p>
                <p>• <span class="text-slate-200">Storage & Deployments:</span> Clonezilla • Ventoy • Partition Repair (GParted) • NIST 800-88 Disk Sanitization</p>
              </div>
            </details>
          </div>

        </div>
      </section>

      <!-- Full Work Experience Section -->
      <section class="resume-section mb-6 print:mb-3">
        <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2 print:border-b print:border-black print:pb-0.5">// Professional Work Experience</h2>
        <div class="space-y-3 print:space-y-2 text-xs sm:text-sm">
          
          <!-- Walmart -->
          <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-0.5">
              <span class="font-bold text-white resume-title">Digital Personal Shopper</span>
              <span class="text-xs font-mono text-slate-400 font-medium resume-badge">July 2024 – Present</span>
            </div>
            <p class="text-xs text-slate-400 italic mb-1.5 resume-desc">Walmart • Indiana, PA</p>
            <ul class="list-disc list-inside text-xs text-slate-400 space-y-0.5 resume-desc">
              <li>Manage high-velocity inventory staging, exception routing, and digital order dispatching across a catalog of thousands of retail SKUs.</li>
              <li>Operate handheld enterprise mobile computers (TC units) to track parcel custody, resolve barcode discrepancies, and maintain chain-of-custody accuracy.</li>
              <li>Coordinate sorting queues to optimize throughput and resolve backroom staging bottlenecks.</li>
            </ul>
          </div>

          <!-- IUP Library -->
          <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-0.5">
              <span class="font-bold text-white resume-title">Information Desk / Serials Receptionist</span>
              <span class="text-xs font-mono text-slate-400 font-medium resume-badge">July 2023 – June 2025</span>
            </div>
            <p class="text-xs text-slate-400 italic mb-1.5 resume-desc">IUP Library • Indiana, PA</p>
            <ul class="list-disc list-inside text-xs text-slate-400 space-y-0.5 resume-desc">
              <li>Managed frontline communications for the library and campus, answering incoming phone calls, in-person questions, and support emails.</li>
              <li>Handled initial triage for student and visitor support inquiries, providing direct answers or routing questions to the correct campus department.</li>
              <li>Processed support tickets, looked up directory and building information, and assisted patrons with library resources.</li>
            </ul>
          </div>

          <!-- Advance Auto Parts -->
          <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-0.5">
              <span class="font-bold text-white resume-title">Salesperson</span>
              <span class="text-xs font-mono text-slate-400 font-medium resume-badge">June 2023 – July 2024</span>
            </div>
            <p class="text-xs text-slate-400 italic mb-1.5 resume-desc">Advance Auto Parts • Indiana, PA</p>
            <ul class="list-disc list-inside text-xs text-slate-400 space-y-0.5 resume-desc">
              <li>Conducted on-site vehicular diagnostic scans using OBD-II computer interfaces, interpreting error codes for systematic hardware troubleshooting.</li>
              <li>Queried electronic inventory databases and legacy catalogs to verify component compatibility, part numbers, and replenishment pipelines.</li>
              <li>Maintained accurate inventory tracking, cycle counts, and shelf organization standards.</li>
            </ul>
          </div>

        </div>
      </section>

      <!-- Education -->
      <section class="resume-section">
        <h2 class="section-title text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2 print:border-b print:border-black print:pb-0.5">// Education</h2>
        <div class="resume-box p-3 bg-slate-900/60 border border-slate-800 rounded">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-0.5">
            <span class="font-bold text-white resume-title">Bachelor of Arts in Criminology</span>
            <span class="text-xs font-mono text-slate-400 font-medium resume-badge">Expected: August 2027</span>
          </div>
          <p class="text-xs text-slate-400 resume-desc">Indiana University of Pennsylvania (IUP) — Indiana, PA</p>
          <p class="text-xs text-slate-400 mt-1 resume-desc">Focus on criminal investigation, legal evidence handling, and statutory compliance. Relevant coursework in Computer Science (CMSC) Unix systems programming, real-time architectures, and scheduling.</p>
        </div>
      </section>

    </div>
  </div>

  <!-- FIXED MODAL: Locked to viewport center with z-[99999] -->
  <div 
    id="print-verify-modal" 
    class="print:hidden fixed inset-0 z-[99999] bg-black/80 backdrop-blur-md hidden flex-col items-center justify-center p-4 select-none"
    style="display: none;"
  >
    <div class="bg-slate-900 border border-slate-700 w-full max-w-sm rounded-xl shadow-2xl p-6 text-center font-mono flex flex-col items-center gap-3 animate-fade-in relative">
      <div class="text-[11px] text-emerald-400 border border-emerald-800 bg-emerald-950/70 px-2.5 py-0.5 rounded">
        ❯ BOT_CHECK // VERIFICATION
      </div>
      <h3 class="text-sm font-bold text-white font-sans">Human Verification</h3>
      <p class="text-xs text-slate-400 leading-relaxed font-sans">
        Complete the check below to reveal contact details and proceed.
      </p>
      
      <!-- Mount container -->
      <div id="modal-turnstile-slot" class="w-full flex items-center justify-center min-h-[75px] my-1"></div>
      
      <button 
        id="cancel-verify-btn" 
        type="button" 
        class="text-xs text-slate-500 hover:text-slate-300 transition cursor-pointer mt-1"
      >
        [Cancel]
      </button>
    </div>
  </div>

  <!-- Inline Turnstile Script & Interceptor -->
  <script define:vars={{ siteKey }}>
    const encodedInbox = "Y29udGFjdEBtdm9vcmhpZXMuY29t";
    let isVerified = false;
    let turnstileWidgetId = null;

    function applyDecodedEmail() {
      const email = atob(encodedInbox);
      isVerified = true;

      // 1. Completely hide the "Verify to reveal email" button and its container
      const gateContainer = document.getElementById('email-gate-container');
      const triggerBtn = document.getElementById('trigger-turnstile-btn');
      if (gateContainer) {
        gateContainer.style.display = 'none';
        gateContainer.classList.add('hidden');
      }
      if (triggerBtn) {
        triggerBtn.style.display = 'none';
        triggerBtn.classList.add('hidden');
      }

      // 2. Reveal the clickable email link in the header
      const emailRevealed = document.getElementById('email-revealed');
      const emailLink = document.getElementById('email-link');
      if (emailRevealed && emailLink) {
        emailLink.textContent = email;
        emailLink.href = 'mailto:' + email;
        emailRevealed.style.display = 'inline';
        emailRevealed.classList.remove('hidden');
      }

      // 3. Update the Print Document Target
      const printTarget = document.getElementById('print-email-target');
      if (printTarget) {
        printTarget.textContent = email;
      }
    }

    function ensureModalInBody() {
      const modal = document.getElementById('print-verify-modal');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }

    function openVerificationModal(callbackOnComplete) {
      if (isVerified) {
        if (callbackOnComplete) callbackOnComplete();
        return;
      }

      ensureModalInBody();
      const modal = document.getElementById('print-verify-modal');
      if (!modal) return;

      modal.style.display = 'flex';
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      function mountTurnstile() {
        if (!window.turnstile) return;
        const slot = document.getElementById('modal-turnstile-slot');
        if (!slot) return;

        if (turnstileWidgetId !== null) {
          window.turnstile.reset(turnstileWidgetId);
          return;
        }

        turnstileWidgetId = window.turnstile.render('#modal-turnstile-slot', {
          sitekey: siteKey,
          theme: 'dark',
          callback: function(token) {
            applyDecodedEmail();
            closeModal();
            if (callbackOnComplete) callbackOnComplete();
          }
        });
      }

      if (window.turnstile) {
        mountTurnstile();
      } else {
        const poll = setInterval(() => {
          if (window.turnstile) {
            clearInterval(poll);
            mountTurnstile();
          }
        }, 100);
      }
    }

    function closeModal() {
      const modal = document.getElementById('print-verify-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
      document.body.style.overflow = '';
    }

    function setupInterceptors() {
      ensureModalInBody();

      // Trigger from Header [VERIFY TO REVEAL EMAIL] button
      const triggerBtn = document.getElementById('trigger-turnstile-btn');
      triggerBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        openVerificationModal();
      });

      // Trigger from Print/PDF Button
      const printBtn = document.getElementById('resume-print-btn');
      printBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        openVerificationModal(() => {
          window.print();
        });
      });

      // Trigger from Ctrl+P / Cmd+P
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'p') {
          if (!isVerified) {
            e.preventDefault();
            openVerificationModal(() => {
              window.print();
            });
          }
        }
        if (e.key === 'Escape') {
          closeModal();
        }
      });

      // Modal Close Handlers
      document.getElementById('cancel-verify-btn')?.addEventListener('click', closeModal);
      document.getElementById('print-verify-modal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('print-verify-modal')) {
          closeModal();
        }
      });
    }

    setupInterceptors();
    document.addEventListener('astro:after-swap', setupInterceptors);
  </script>

  <!-- Print Stylesheet -->
  <style is:global>
    @media print {
      nav, footer, .command-palette, #ambient-scroll-line, [class*="TerminalHeader"], [class*="terminal-header"], details summary, details div, #print-verify-modal {
        display: none !important;
      }

      html, body {
        background-color: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .resume-box {
        background-color: transparent !important;
        border: 1px solid #000000 !important;
        box-shadow: none !important;
      }

      .resume-title,
      .resume-desc,
      .resume-badge,
      .resume-text,
      .section-title,
      p, span, div, strong, li {
        color: #000000 !important;
      }

      a, a:visited, a:hover, a:active {
        color: #000000 !important;
        text-decoration: none !important;
        border-bottom: none !important;
      }

      .section-title {
        border-bottom: 1px solid #000000 !important;
      }
    }
  </style>
</BaseLayout>
