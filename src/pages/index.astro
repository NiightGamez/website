---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Systems, Infrastructure & Security" currentPage="home">
  <!-- Hero Section -->
  <header class="mb-10 sm:mb-12 animate-fade-in delay-100">
    <div class="inline-block px-2.5 py-0.5 mb-3 bg-emerald-950/60 border border-emerald-800/60 font-mono text-xs text-emerald-400 rounded">
      ❯ SYSTEM_PROFILE // GENERAL_COMPUTING
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-white leading-tight font-mono glitch-hover">
      Systems, Networking &amp; Defensive Security
    </h1>
    <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6 font-sans">
      Systems, networking, and defensive security, learned by building and running my own infrastructure. Student, still exploring, always tinkering.
    </p>
    <div class="flex flex-wrap gap-2 font-mono">
      <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-xs rounded text-slate-300">CompTIA Security+</span>
      <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-xs rounded text-slate-300">CompTIA Network+</span>
      <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-xs rounded text-slate-300">CompTIA A+</span>
      <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-xs rounded text-emerald-400">Debian / Proxmox</span>
    </div>
  </header>

  <!-- Neofetch / Terminal System Card with Profile Picture -->
  <section class="mb-10 bg-slate-950/80 border border-slate-800/90 rounded-xl p-5 sm:p-6 font-mono text-xs shadow-xl">
    <div class="flex justify-between items-center text-slate-500 pb-3 mb-5 border-b border-slate-800/60">
      <span>system_info --user mvoorhies</span>
      <span class="text-emerald-400">NODE: mischief-managed</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <!-- Profile Picture Badge -->
      <div class="md:col-span-4 flex flex-col items-center justify-center p-3 bg-slate-900/60 border border-slate-800 rounded-lg text-center">
        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-lg overflow-hidden border-2 border-emerald-500/40 shadow-lg mb-3">
          <img src="/favicon.png" alt="Michael Voorhies" class="w-full h-full object-cover" />
        </div>
        <span class="text-emerald-400 font-bold text-xs tracking-wider">MICHAEL VOORHIES</span>
        <span class="text-slate-500 text-[10px]">@NIIGHTGAMEZ</span>
      </div>

      <!-- System Telemetry Readout -->
      <div class="md:col-span-8 space-y-1.5 text-slate-300 text-[11px] leading-relaxed">
        <div><span class="text-emerald-400 font-semibold">mvoorhies</span>@<span class="text-slate-400">mischief-managed</span></div>
        <div class="text-slate-700">------------------------------------</div>
        <div><span class="text-slate-500">Identity:</span> Michael Voorhies</div>
        <div><span class="text-slate-500">Background:</span> Criminology &amp; Unix Systems</div>
        <div><span class="text-slate-500">Host:</span> Proxmox VE (LXC ct-102)</div>
        <div><span class="text-slate-500">OS:</span> Debian 12 (x86_64)</div>
        <div><span class="text-slate-500">Certifications:</span> CompTIA Sec+, Net+, A+</div>
        <div><span class="text-slate-500">Core Focus:</span> Real-Time Systems &bull; Blue-Team Telemetry</div>
        <div><span class="text-slate-500">Ingress:</span> Cloudflare Zero Trust (mvoorhies.com)</div>
        <div><span class="text-slate-500">Session Uptime:</span> 287 days, live</div>

        <!-- Terminal ANSI Color Bar -->
        <div class="flex gap-1.5 pt-2">
          <span class="w-3 h-3 rounded-sm bg-slate-800"></span>
          <span class="w-3 h-3 rounded-sm bg-rose-500"></span>
          <span class="w-3 h-3 rounded-sm bg-emerald-500"></span>
          <span class="w-3 h-3 rounded-sm bg-amber-500"></span>
          <span class="w-3 h-3 rounded-sm bg-cyan-500"></span>
          <span class="w-3 h-3 rounded-sm bg-purple-500"></span>
          <span class="w-3 h-3 rounded-sm bg-slate-100"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Cards -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-10 animate-fade-in delay-200">
    <a href="/portfolio" class="p-6 bg-slate-900/60 border border-slate-800/90 rounded-xl card-hover flex flex-col justify-between group">
      <div>
        <div class="font-mono text-xs text-emerald-400 mb-1">01 // REPOSITORIES</div>
        <h2 class="text-xl font-bold mb-2 text-white flex items-center justify-between font-mono">
          <span class="glitch-hover">Projects &amp; Labs</span>
          <span class="text-emerald-400 group-hover:translate-x-1 transition-transform duration-200 text-sm">&rarr;</span>
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed font-sans">
          Real-time scheduling algorithms, Unix automation, host auditing, and security lab tooling synced directly from GitHub.
        </p>
      </div>
    </a>

    <a href="/homelab" class="p-6 bg-slate-900/60 border border-slate-800/90 rounded-xl card-hover flex flex-col justify-between group">
      <div>
        <div class="font-mono text-xs text-emerald-400 mb-1">02 // INFRASTRUCTURE</div>
        <h2 class="text-xl font-bold mb-2 text-white flex items-center justify-between font-mono">
          <span class="glitch-hover">Homelab Architecture</span>
          <span class="text-emerald-400 group-hover:translate-x-1 transition-transform duration-200 text-sm">&rarr;</span>
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed font-sans">
          Virtualization with Proxmox VE, container orchestration, identity management, and secure Cloudflare ingress.
        </p>
      </div>
    </a>
  </section>

  <!-- Colophon -->
  <section class="p-5 bg-slate-900/40 border border-slate-800/80 rounded-xl text-xs text-slate-400 leading-relaxed font-mono animate-fade-in delay-300">
    <div class="flex items-center gap-2 text-emerald-400 font-semibold mb-1">
      <span>// COLOPHON &amp; TRANSPARENCY</span>
    </div>
    <p class="font-sans text-slate-400 text-xs leading-relaxed">
      This site acts as a live directory and personal workbench. The layout, styling, and boilerplate components were scaffolded with AI assistance, while the underlying virtualization, network security rules, and engineering projects reflect authentic, hands-on implementations.
    </p>
  </section>
</BaseLayout>
